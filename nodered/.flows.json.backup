    {
        "id": "85a4662a82a5b899",
        "type": "function",
        "z": "f65d29de0116f69b",
        "name": "Preparar resultados",
        "func": "const result = msg.payload;\n\nconst mensajes = [];\n\n// ======================================================\n// RECORRER TODOS LOS RESULTADOS\n// ======================================================\n\nfor (const tipo in result) {\n\n    mensajes.push({\n\n        topic: \"bms/diagnostico/resultado/\" + tipo,\n\n        payload: result[tipo]\n\n    });\n}\n\n// Enviar todos los mensajes por la salida 1\n\nreturn [mensajes];",
