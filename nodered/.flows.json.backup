    {
        "id": "a38f4c9cd0c26bf0",
        "type": "function",
        "z": "548bfb93b2adf834",
        "name": "Store drivers",
        "func": "const fs = global.get(\"fs\");\nconst path = global.get(\"path\");\n\nif (!fs || !path) {\n    node.error(\"fs o path no están cargados.\");\n    return null;\n}\n\nconst drivers = {};\n\ntry {\n\n    // Leer todos los archivos de la carpeta\n    const files = fs.readdirSync(\"/drivers\");\n\n    for (const file of files) {\n\n        // Ignorar todo lo que no sea JSON\n        if (!file.endsWith(\".json\")) {\n            continue;\n        }\n\n        // Ruta completa\n        const fullPath = path.join(\"/drivers\", file);\n\n        // Leer archivo\n        const json = fs.readFileSync(fullPath, \"utf8\");\n\n        // Convertir texto a objeto\n        const driver = JSON.parse(json);\n\n        // Nombre del driver = nombre del archivo\n        const driverId = path.basename(file, \".json\");\n\n        drivers[driverId] = driver;\n    }\n\n    global.set(\"drivers\", drivers);\n\n    node.status({\n        fill: \"green\",\n        shape: \"dot\",\n        text: Object.keys(drivers).length + \" drivers\"\n    });\n\n    msg.payload = drivers;\n\n    return msg;\n\n} catch(err) {\n\n    node.status({\n        fill: \"red\",\n        shape: \"ring\",\n        text: err.message\n    });\n\n    node.error(err);\n\n    return null;\n\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 420,
        "wires": [
            []
        ]
    },
    {
        "id": "f94f8bdbdb83f18d",
        "type": "function",
        "z": "548bfb93b2adf834",
        "name": "Decode Value",
        "func": "function registersToFloat(registers) {\n\n    const buffer = Buffer.alloc(4);\n\n    buffer.writeUInt16BE(registers[0], 0);\n    buffer.writeUInt16BE(registers[1], 2);\n\n    return buffer.readFloatBE(0);\n\n}\n\nlet value;\n\nswitch (msg.variable.type) {\n\n    case \"float\":\n\n        value = registersToFloat(msg.payload);\n\n        break;\n\n    default:\n\n        node.error(\"Tipo de dato no soportado: \" + msg.variable.type);\n        return null;\n}\n\nmsg.payload = {\n\n    point: msg.point,\n\n    value: Number(value.toFixed(msg.variable.decimals))\n\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 820,
        "wires": [
            []
        ]
    },
    {
        "id": "7b4d6d0a93884e43",
        "type": "function",
        "z": "548bfb93b2adf834",
        "name": "Buid Measurement",
        "func": "msg.payload = {\n\n    deviceId: msg.device.id,\n\n    timestamp: new Date().toISOString(),\n\n    measurements: msg.payload\n\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 730,
        "y": 840,
        "wires": [
            []
        ]
    },
