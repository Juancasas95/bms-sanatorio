    {
        "id": "aefcd7a703c2ba1d",
        "type": "function",
        "z": "f65d29de0116f69b",
        "name": "Decoder",
        "func": "const regs = msg.payload;\n\n// Verificar que llegaron datos\nif (!Array.isArray(regs) || regs.length === 0) {\n    node.error(\"No llegaron registros Modbus válidos\");\n    return null;\n}\n\nconst result = {};\n\n// ======================================================\n// REGISTROS CRUDOS\n// ======================================================\n\nresult.raw = regs;\n\n// ======================================================\n// BOOL\n// ======================================================\n\nresult.bool = regs[0] !== 0;\n\n// ======================================================\n// UINT16\n// ======================================================\n\nresult.uint16 = regs[0];\n\n// ======================================================\n// INT16\n// ======================================================\n\n{\n    const b = Buffer.alloc(2);\n\n    b.writeUInt16BE(regs[0], 0);\n\n    result.int16 = b.readInt16BE(0);\n}\n\n// ======================================================\n// DATOS DE 32 BITS\n// Se necesitan mínimo 2 registros\n// ======================================================\n\nif (regs.length >= 2) {\n\n    const r0 = regs[0];\n    const r1 = regs[1];\n\n    // --------------------------------------------------\n    // ABCD\n    // Registro 1 = AB\n    // Registro 2 = CD\n    // --------------------------------------------------\n\n    {\n        const b = Buffer.alloc(4);\n\n        b.writeUInt16BE(r0, 0);\n        b.writeUInt16BE(r1, 2);\n\n        result.int32_abcd = b.readInt32BE(0);\n        result.uint32_abcd = b.readUInt32BE(0);\n        result.float_abcd = b.readFloatBE(0);\n    }\n\n    // --------------------------------------------------\n    // CDAB\n    // Registro 2 primero\n    // Registro 1 después\n    // --------------------------------------------------\n\n    {\n        const b = Buffer.alloc(4);\n\n        b.writeUInt16BE(r1, 0);\n        b.writeUInt16BE(r0, 2);\n\n        result.int32_cdab = b.readInt32BE(0);\n        result.uint32_cdab = b.readUInt32BE(0);\n        result.float_cdab = b.readFloatBE(0);\n    }\n\n    // --------------------------------------------------\n    // BCAD\n    // Intercambio de bytes dentro de cada registro\n    //\n    // ABCD → BADC\n    // --------------------------------------------------\n\n    {\n        const b = Buffer.alloc(4);\n\n        b[0] = r0 & 0xFF;\n        b[1] = (r0 >> 8) & 0xFF;\n\n        b[2] = r1 & 0xFF;\n        b[3] = (r1 >> 8) & 0xFF;\n\n        result.int32_bcad = b.readInt32BE(0);\n        result.uint32_bcad = b.readUInt32BE(0);\n    }\n}\n\n// ======================================================\n// DATOS DE 64 BITS\n// Se necesitan mínimo 4 registros\n// ======================================================\n\nif (regs.length >= 4) {\n\n    const b = Buffer.alloc(8);\n\n    b.writeUInt16BE(regs[0], 0);\n    b.writeUInt16BE(regs[1], 2);\n    b.writeUInt16BE(regs[2], 4);\n    b.writeUInt16BE(regs[3], 6);\n\n    result.int64 = b.readBigInt64BE(0).toString();\n\n    result.uint64 = b.readBigUInt64BE(0).toString();\n}\n\n// ======================================================\n// DEVOLVEMOS TODO\n// ======================================================\n\nmsg.payload = result;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 260,
        "wires": [
