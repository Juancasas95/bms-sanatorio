    {
        "id": "0aed70eab8660dd4",
        "type": "function",
        "z": "091af37d2933f7aa",
        "name": "Load Devices",
        "func": "// 1. Obtenemos el objeto con todos los dispositivos desde la memoria global\nconst devices = global.get(\"devices\");\n\n// 2. Control de seguridad por si la memoria está vacía\nif (!devices) {\n    node.status({ fill: \"red\", shape: \"ring\", text: \"Sin datos en memoria\" });\n    return null;\n}\n\n// 3. Extraemos TODOS los nombres de los objetos principales\n// Si tu JSON es {\"BC2\": {...}, \"BC1\": {...}}, esto devolverá [\"BC2\", \"BC1\"]\nconst allDeviceNames = Object.keys(devices);\n\n// 4. Guardamos la lista en el payload para enviarla al siguiente nodo\nmsg.payload = allDeviceNames;\n\n// 5. Mostramos en el nodo cuántos nombres encontramos\nnode.status({ \n    fill: \"green\", \n    shape: \"dot\", \n    text: \"Extraídos \" + allDeviceNames.length + \" nombres\" \n});\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 160,
        "wires": [
            [
                "18234493e726e080",
                "888eb8f67834ef8b"
            ]
        ]
    },
