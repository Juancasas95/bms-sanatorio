        "id": "b3d4e52bb6a381df",
        "type": "function",
        "z": "f65d29de0116f69b",
        "name": "Preparar comando",
        "func": "let req;\n\ntry {\n    req = typeof msg.payload === \"string\"\n        ? JSON.parse(msg.payload)\n        : msg.payload;\n} catch (e) {\n    node.error(\"JSON inválido recibido desde FUXA\");\n    return null;\n}\n\nmsg.payload = {\n    fc: Number(req.fc),\n    address: Number(req.address),\n    quantity: Number(req.quantity),\n    unitid: Number(req.unitid)\n};\n\nreturn msg;",
