    {
        "id": "ae24dbfdd08501e6",
        "type": "function",
        "z": "291f91c97ecd24c1",
        "name": "Buid Measurement",
        "func": "const deviceId = msg.device.id;\n\nif (!deviceId) {\n    node.error(\"No existe device.id\");\n    return null;\n}\n\nlet cache = flow.get(\"measurements\") || {};\n\n// Crear almacenamiento del dispositivo\nif (!cache[deviceId]) {\n    cache[deviceId] = {};\n}\n\n// Guardar la variable recibida\ncache[deviceId][msg.point] = {\n\n    name: msg.variable.name,\n\n    value: msg.payload.value,\n\n    unit: msg.variable.unit,\n\n    timestamp: new Date().toISOString()\n\n};\n\n// Guardar nuevamente el cache\nflow.set(\"measurements\", cache);\n\n// ¿Cuántos puntos esperamos para este dispositivo? va a contar automaticamente segun las variables que tenga el driver\nconst expectedPoints = Object.keys(msg.device.driver.variables).length;\n\n// Si todavía faltan variables, esperamos\nif (Object.keys(cache[deviceId]).length < expectedPoints) {\n    return null;\n}\n\n//======================================================\n// Todas las variables fueron adquiridas\n//======================================================\n\nmsg.payload = {\n\n    deviceId: deviceId,\n\n    deviceName: msg.device.name,\n\n    gateway: msg.device.gateway.id,\n\n    driver: msg.device.driver.id,\n\n    timestamp: new Date().toISOString(),\n\n    measurements: cache[deviceId]\n\n};\n\n// Limpiar memoria para el próximo ciclo\ndelete cache[deviceId];\n\nflow.set(\"measurements\", cache);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
