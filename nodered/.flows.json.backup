    {
        "id": "ae86e0fde51d877a",
        "type": "function",
        "z": "ff59ca75e9791696",
        "name": "Resolve Device",
        "func": "const deviceId = msg.payload.deviceId;\n\nconst devices = global.get(\"devices\");\n\nif (!devices) {\n    node.error(\"La configuración de dispositivos no está cargada.\");\n    return null;\n}\n\nconst device = devices[deviceId];\n\nif (!device) {\n    node.error(`No existe el dispositivo ${deviceId}`);\n    return null;\n}\n\n// Creamos una copia para no modificar la configuración original\nmsg.device = JSON.parse(JSON.stringify(device));\n\nmsg.device.id = deviceId;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 120,
        "wires": [
            [
                "06c6015263848b97",
                "e84df070de809d8c"
            ]
        ]
    },
    {
        "id": "06c6015263848b97",
        "type": "function",
        "z": "ff59ca75e9791696",
        "name": "Resolve Gateway",
        "func": "const gateways = global.get(\"gateways\");\n\nif (!gateways) {\n    node.error(\"No existe gateways en memoria\");\n    return null;\n}\n\nconst gatewayName = msg.device.gateway;\n\nconst gateway = gateways[gatewayName];\n\nif (!gateway) {\n    node.error(`Gateway ${gatewayName} inexistente`);\n    return null;\n}\n\nmsg.device.gateway = JSON.parse(JSON.stringify(gateway));\n\nmsg.device.gateway.id = gatewayName;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 120,
        "wires": [
            [
                "8bfc9931c8adc0ca"
            ]
        ]
    },
    {
        "id": "8bfc9931c8adc0ca",
        "type": "function",
        "z": "ff59ca75e9791696",
        "name": "Resolve Driver",
        "func": "const drivers = global.get(\"drivers\");\n\nif (!drivers) {\n    node.error(\"No existen drivers cargados\");\n    return null;\n}\n\nconst driverName = msg.device.driver;\n\nconst driver = drivers[driverName];\n\nif (!driver) {\n    node.error(`Driver ${driverName} inexistente`);\n    return null;\n}\n\nmsg.device.driver = JSON.parse(JSON.stringify(driver));\n\nmsg.device.driver.id = driverName;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 840,
        "y": 120,
        "wires": [
            [
                "d8daabcc525b4539"
            ]
        ]
    },
