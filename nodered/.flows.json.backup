    {
        "id": "5ccb84dc534f67c4",
        "type": "function",
        "z": "ae56baca30656258",
        "name": "MQTT Formatter (new)",
        "func": "const data = msg.payload;\n\nconst gateway = data.gateway;\nconst deviceId = data.deviceId;\n\nfor (const pointName in data.measurements) {\n\n    const m = data.measurements[pointName];\n\n    node.send({\n\n        _msgid: msg._msgid,\n\n        topic: `bms/${gateway}/${deviceId}/${pointName}`,\n\n        payload: m.value,\n\n        metadata: {\n            gateway,\n            deviceId,\n            point: pointName,\n            name: m.name,\n            unit: m.unit,\n            quality: m.quality || \"GOOD\",\n            timestamp: m.timestamp\n        }\n\n    });\n\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 460,
        "wires": [
            []
        ]
    },
