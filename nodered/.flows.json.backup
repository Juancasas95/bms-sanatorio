    {
        "id": "cb9cc3c9aaafed34",
        "type": "function",
        "z": "291f91c97ecd24c1",
        "name": "Buid Job",
        "func": "const device = msg.device;\n\nif (!device) {\n    node.error(\"No llegó ningún dispositivo.\");\n    return null;\n}\n\nif (!device.driver) {\n    node.error(\"El dispositivo no tiene driver.\");\n    return null;\n}\n\n//if (!Array.isArray(device.points)) {\n//    node.error(\"El dispositivo no tiene lista de puntos.\");\n//    return null;\n//}\n\nconst jobs = [];\n\nfor (const pointName of Object.keys(device.driver.variables)) {// con objects keys, dejamos de depender del puntero en devices.json\n\n    const variable = device.driver.variables[pointName];\n\n    if (!variable) {\n\n        node.warn(`La variable ${pointName} no existe en el driver ${device.driver.id}`);\n\n        continue;\n    }\n\n    jobs.push({\n\n        device: device,\n\n        point: pointName,\n\n        variable: variable,\n\n        request: {\n\n            unitid: device.slave,\n\n            fc: variable.fc,\n\n            address: variable.address,\n\n            quantity: variable.quantity\n\n        }\n\n    });\n\n}\n\nmsg.payload = jobs;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
