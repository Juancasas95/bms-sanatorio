    {
        "id": "f7298e8410cb5aa2",
        "type": "function",
        "z": "4ffdac17e98d3ae7",
        "name": "decode",
        "func": "const regs = msg.payload;\n\nif (!Array.isArray(regs)) {\n    node.error(\"No llegaron registros\");\n    return null;\n}\n\nnode.warn(\"Registros recibidos: \" + JSON.stringify(regs));\n\nconst result = {};\n\ntry {\n\n    // Bool\n    result.bool = !!regs[0];\n\n    // UInt16\n    result.uint16 = regs[0];\n\n    // Int16\n    {\n        const b = Buffer.alloc(2);\n        b.writeUInt16BE(regs[0],0);\n        result.int16 = b.readInt16BE(0);\n    }\n\n    if (regs.length >= 2){\n\n        // Float ABCD\n        {\n            const b = Buffer.alloc(4);\n            b.writeUInt16BE(regs[0],0);\n            b.writeUInt16BE(regs[1],2);\n            result.float_ABCD = b.readFloatBE(0);\n        }\n\n        // Float CDAB\n        {\n            const b = Buffer.alloc(4);\n            b.writeUInt16BE(regs[1],0);\n            b.writeUInt16BE(regs[0],2);\n            result.float_CDAB = b.readFloatBE(0);\n        }\n\n        // UInt32 ABCD\n        result.uint32_ABCD =\n            ((regs[0] << 16) >>>0) + regs[1];\n\n        // UInt32 CDAB\n        result.uint32_CDAB =\n            ((regs[1] << 16) >>>0) + regs[0];\n\n        // Int32 ABCD\n        {\n            const b = Buffer.alloc(4);\n            b.writeUInt16BE(regs[0],0);\n            b.writeUInt16BE(regs[1],2);\n            result.int32_ABCD = b.readInt32BE(0);\n        }\n\n        // Int32 CDAB\n        {\n            const b = Buffer.alloc(4);\n            b.writeUInt16BE(regs[1],0);\n            b.writeUInt16BE(regs[0],2);\n            result.int32_CDAB = b.readInt32BE(0);\n        }\n\n    }\n\n}\ncatch(err){\n    node.error(err.message);\n}\n\nmsg.payload = result;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 200,
        "wires": [
            [
                "1afae2ceb51a05bf"
            ]
        ]
