    {
        "id": "f5f2e5965d5ccc46",
        "type": "function",
        "z": "ae56baca30656258",
        "name": "MQTT Formatter (new)",
        "func": "const data = msg.payload;\n\n// Control de seguridad por si el mensaje viene vacío\nif (!data || !data.measurement) {\n    return null;\n}\n\nconst gateway = data.gateway;\nconst deviceId = data.deviceId;\nconst pointName = data.point;      // Ej: VoltageL1\nconst m = data.measurement;        // Datos de la medición\n\n// Enviamos el mensaje individual directo al nodo MQTT Out\nnode.send({\n    _msgid: msg._msgid,\n    topic: `bms/${gateway}/${deviceId}/${pointName}`,\n    payload: m.value, // Envía el número limpio (ej: 220) para FUXA\n    metadata: {\n        gateway,\n        deviceId,\n        point: pointName,\n        name: m.name,\n        unit: m.unit,\n        quality: \"GOOD\",\n        timestamp: m.timestamp\n    }\n});\n\n// Estado visual en el nodo para monitoreo rápido\nnode.status({ \n    fill: \"green\", \n    shape: \"dot\", \n    text: `${pointName}: ${m.value} ${m.unit || ''}` \n});\n\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
