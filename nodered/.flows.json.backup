    {
        "id": "96e574ff7fe5cb22",
        "type": "function",
        "z": "548bfb93b2adf834",
        "name": "Store gateway",
        "func": "const gateways = JSON.parse(msg.payload);\n\nglobal.set(\"gateways\", gateways);\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: Object.keys(gateways).length + \" gateways\"\n});\n\nreturn msg;",
