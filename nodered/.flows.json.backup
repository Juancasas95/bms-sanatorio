    {
        "id": "62ca3c494ff63696",
        "type": "function",
        "z": "291f91c97ecd24c1",
        "name": "Prepare Modbus Request nuevo",
        "func": "const job = msg.payload;\n\n// Conservamos toda la información para los siguientes nodos\nmsg.device = job.device;\nmsg.point = job.point;\nmsg.variable = job.variable;\n\n// Petición exactamente igual a la prueba que funciona\nmsg.payload = {\n\n    fc: job.request.fc,\n\n    unitid: job.request.unitid,\n\n    address: job.request.address,\n\n    quantity: job.request.quantity\n\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 690,
        "y": 100,
        "wires": [
            [
                "fc1dc95282c028d0",
                "127aac3d865e01d7"
            ]
        ]
    },
    {
        "id": "d66fbbe5bb491bb4",
        "type": "modbus-flex-getter",
        "z": "291f91c97ecd24c1",
        "name": "Scu200",
        "showStatusActivities": false,
        "showErrors": false,
        "showWarnings": true,
        "logIOActivities": false,
        "server": "126e4fa809698f73",
        "useIOFile": false,
        "ioFile": "",
        "useIOForPayload": false,
        "emptyMsgOnFail": false,
        "keepMsgProperties": true,
        "delayOnStart": false,
        "enableDeformedMessages": false,
        "startDelayTime": "",
        "x": 340,
        "y": 280,
        "wires": [
            [
                "15574647789b274f",
                "a722ed695c931af6"
