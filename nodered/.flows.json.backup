    {
        "id": "d04af16379baaa94",
        "type": "function",
        "z": "291f91c97ecd24c1",
        "name": "Decode Value",
        "func": "const regs = msg.payload;\n\nif (!Array.isArray(regs)) {\n    return null;\n}\n\nconst variable = msg.variable;\n\nlet value = null;\n\n//==================================================\n// UINT16\n//==================================================\nif (variable.type === \"uint16\") {\n\n    value = regs[0];\n\n}\n\n//==================================================\n// INT16\n//==================================================\nelse if (variable.type === \"int16\") {\n\n    const buffer = Buffer.alloc(2);\n    buffer.writeUInt16BE(regs[0],0);\n    value = buffer.readInt16BE(0);\n\n}\n\n//==================================================\n// UINT32\n//==================================================\nelse if (variable.type === \"uint32\") {\n\n    // Si llegaron 4 registros, usamos solamente los dos primeros.\n    // Esto ocurre en algunos equipos (como el SCU200) que reservan\n    // espacio para una futura expansión a 64 bits.\n\n    const r0 = regs[0];\n    const r1 = regs[1];\n\n    if (variable.swap === true) {\n\n        value = ((r0 << 16) >>> 0) + r1;\n\n    } else {\n\n        value = ((r1 << 16) >>> 0) + r0;\n\n    }\n\n}\n\n//==================================================\n// INT32\n//==================================================\nelse if (variable.type === \"int32\") {\n\n    const buffer = Buffer.alloc(4);\n\n    if (variable.swap === true) {\n\n        buffer.writeUInt16BE(regs[1],0);\n        buffer.writeUInt16BE(regs[0],2);\n\n    } else {\n\n        buffer.writeUInt16BE(regs[0],0);\n        buffer.writeUInt16BE(regs[1],2);\n\n    }\n\n    value = buffer.readInt32BE(0);\n\n}\n\n//==================================================\n// FLOAT\n//==================================================\nelse if (variable.type === \"float\") {\n\n    const buffer = Buffer.alloc(4);\n\n    if (variable.swap === true) {\n\n        buffer.writeUInt16BE(regs[1],0);\n        buffer.writeUInt16BE(regs[0],2);\n\n    } else {\n\n        buffer.writeUInt16BE(regs[0],0);\n        buffer.writeUInt16BE(regs[1],2);\n\n    }\n\n    value = buffer.readFloatBE(0);\n\n}\n\n//==================================================\n\nelse {\n\n    node.error(\"Tipo desconocido: \" + variable.type);\n    return null;\n\n}\n\n// Aplicar multiplicador (viejo)\n\nif (variable.multiplier !== undefined) {\n\n    value *= variable.multiplier;\n\n}\n\n// Redondeo\n\nif (variable.decimals !== undefined) {\n\n    value = Number(value.toFixed(variable.decimals));\n\n}\n\nmsg.payload = {\n    value: value\n};\n\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 580,
        "wires": [
            []
        ]
    },
    {
        "id": "23d8ed7fe8b8e56c",
        "type": "function",
        "z": "291f91c97ecd24c1",
        "name": "Buid Measurement",
        "func": "const deviceId = msg.device.id;\n\nif (!deviceId) {\n    node.error(\"No existe device.id\");\n    return null;\n}\n\n// Cache de medidas del dispositivo (guarda el histórico en memoria)\nlet cache = flow.get(\"measurements\") || {};\n\nif (!cache[deviceId]) {\n    cache[deviceId] = {};\n}\n\n// Actualizar únicamente la variable recibida en este instante\ncache[deviceId][msg.point] = {\n    name: msg.variable.name,\n    value: msg.payload.value,\n    unit: msg.variable.unit,\n    timestamp: new Date().toISOString()\n};\n\nflow.set(\"measurements\", cache);\n\n// Publicar inmediatamente un payload plano con la variable actual\nmsg.payload = {\n    deviceId: deviceId,\n    deviceName: msg.device.name,\n    gateway: msg.device.gateway.id,\n    driver: msg.device.driver.id,\n    point: msg.point,\n    measurement: cache[deviceId][msg.point]\n};\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 340,
        "wires": [
            [
                "bd6bbb12a2d744f8"
            ]
        ]
    },
    {
        "id": "b2dabe46cccd620c",
