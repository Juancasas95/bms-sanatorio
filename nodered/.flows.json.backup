    {
        "id": "02c3926f17669389",
        "type": "function",
        "z": "6c26a882f341bc4c",
        "name": "MQTT Formatter",
        "func": "const data = msg.payload;\n\nconst gateway = data.gateway;\nconst device = data.deviceId;\n\nconst messages = [];\n\nfor (const pointName in data.measurements) {\n\n    const measurement = data.measurements[pointName];\n\n    messages.push({\n\n        topic: `bms/${gateway}/${device}/${pointName}`,\n\n        payload: {\n\n            value: measurement.value,\n\n            unit: measurement.unit,\n\n            quality: \"GOOD\",\n\n            timestamp: measurement.timestamp\n\n        }\n\n    });\n\n}\n\nmsg.payload = messages;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530.1999816894531,
        "y": 495.1999816894531,
        "wires": [
            []
        ]
    },
    {
        "id": "de3b531181c63106",
        "type": "change",
        "z": "6c26a882f341bc4c",
