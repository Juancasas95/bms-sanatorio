    {
        "id": "6dc13f2912f881d0",
        "type": "function",
        "z": "291f91c97ecd24c1",
        "name": "Buid Job (new)",
        "func": "const device = msg.device;\n\nif (!device) {\n    node.error(\"No llegó ningún dispositivo.\");\n    return null;\n}\n\nif (!device.driver) {\n    node.error(\"El dispositivo no tiene driver.\");\n    return null;\n}\n\nconst jobs = [];\n\n// Base de tiempos de adquisición\nlet scanState = global.get(\"scanState\") || {};\n\nconst now = Date.now();\n\nfor (const pointName of Object.keys(device.driver.variables)) {\n\n    const variable = device.driver.variables[pointName];\n\n    if (!variable) {\n        node.warn(`La variable ${pointName} no existe en el driver ${device.driver.id}`);\n        continue;\n    }\n\n    // Identificador único de la variable\n    const key = `${device.id}.${pointName}`;\n\n    const lastRead = scanState[key] || 0;\n\n    // Si no existe scan, leer siempre\n    const scan = Number(variable.scan ?? 1000);\n\n    if (scan > 0 && (now - lastRead) < scan) {\n        continue;\n    }\n\n    // Actualizar instante de lectura\n    scanState[key] = now;\n\n    jobs.push({\n\n        device: device,\n\n        point: pointName,\n\n        variable: variable,\n\n        request: {\n\n            unitid: device.slave,\n\n            fc: variable.fc,\n\n            address: variable.address,\n\n            quantity: variable.quantity\n\n        }\n\n    });\n\n}\n\nglobal.set(\"scanState\", scanState);\n\nif (jobs.length === 0) {\n    return null;\n}\n\nmsg.payload = jobs;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 240,
        "y": 100,
        "wires": [
            [
                "556b1e97ecc705a4",
                "6d25218f209cdd9b"
            ]
        ]
    },
