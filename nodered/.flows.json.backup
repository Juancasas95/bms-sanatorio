    {
        "id": "ff758161dc2b7b51",
        "type": "function",
        "z": "548bfb93b2adf834",
        "name": "Store devices",
        "func": "const devices = JSON.parse(msg.payload);\n\nglobal.set(\"devices\", devices);\n\nnode.status({\n    fill:\"green\",\n    shape:\"dot\",\n    text:Object.keys(devices).length+\" devices\"\n});\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
