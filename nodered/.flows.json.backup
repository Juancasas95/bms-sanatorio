    {
        "id": "a722ed695c931af6",
        "type": "function",
        "z": "291f91c97ecd24c1",
        "name": "Decode Value (new switch)",
        "func": "const regs = msg.payload;\n\nif (!Array.isArray(regs)) {\n    return null;\n}\n\nconst variable = msg.variable;\n\nlet value;\n\n//==================================================\n// Decodificación según tipo\n//==================================================\n\nswitch (variable.type) {\n\n    //--------------------------------------------------\n    // BOOL\n    //--------------------------------------------------\n    case \"bool\":\n        //value = !!regs[0];\n        value = regs[0] ? 1 : 0;//acondicionamos el dato a realbool\n        break;\n\n    //--------------------------------------------------\n    // UINT16\n    //--------------------------------------------------\n    case \"uint16\":\n        value = regs[0];\n        break;\n\n    //--------------------------------------------------\n    // INT16\n    //--------------------------------------------------\n    case \"int16\": {\n\n        const buffer = Buffer.alloc(2);\n        buffer.writeUInt16BE(regs[0], 0);\n        value = buffer.readInt16BE(0);\n        break;\n\n    }\n\n    //--------------------------------------------------\n    // UINT32\n    //--------------------------------------------------\n    case \"uint32\": {\n\n        const r0 = regs[0];\n        const r1 = regs[1];\n\n        if (variable.swap) {\n            value = ((r0 << 16) >>> 0) + r1;\n        } else {\n            value = ((r1 << 16) >>> 0) + r0;\n        }\n\n        break;\n\n    }\n\n    //--------------------------------------------------\n    // INT32\n    //--------------------------------------------------\n    case \"int32\": {\n\n        const buffer = Buffer.alloc(4);\n\n        if (variable.swap) {\n            buffer.writeUInt16BE(regs[1], 0);\n            buffer.writeUInt16BE(regs[0], 2);\n        } else {\n            buffer.writeUInt16BE(regs[0], 0);\n            buffer.writeUInt16BE(regs[1], 2);\n        }\n\n        value = buffer.readInt32BE(0);\n        break;\n\n    }\n\n    //--------------------------------------------------\n    // FLOAT\n    //--------------------------------------------------\n    case \"float\": {\n\n        const buffer = Buffer.alloc(4);\n\n        if (variable.swap) {\n            buffer.writeUInt16BE(regs[1], 0);\n            buffer.writeUInt16BE(regs[0], 2);\n        } else {\n            buffer.writeUInt16BE(regs[0], 0);\n            buffer.writeUInt16BE(regs[1], 2);\n        }\n\n        value = buffer.readFloatBE(0);\n        break;\n\n    }\n\n    //--------------------------------------------------\n    // DOUBLE (reservado)\n    //--------------------------------------------------\n    case \"double\":\n        node.error(\"Tipo DOUBLE aún no implementado.\");\n        return null;\n\n    //--------------------------------------------------\n    // UINT64 (reservado)\n    //--------------------------------------------------\n    case \"uint64\":\n        node.error(\"Tipo UINT64 aún no implementado.\");\n        return null;\n\n    //--------------------------------------------------\n    // INT64 (reservado)\n    //--------------------------------------------------\n    case \"int64\":\n        node.error(\"Tipo INT64 aún no implementado.\");\n        return null;\n\n    //--------------------------------------------------\n    // STRING (reservado)\n    //--------------------------------------------------\n    case \"string\":\n        node.error(\"Tipo STRING aún no implementado.\");\n        return null;\n\n    //--------------------------------------------------\n    // Desconocido\n    //--------------------------------------------------\n    default:\n        node.error(`Tipo desconocido: ${variable.type}`);\n        return null;\n}\n\n//==================================================\n// Post-procesado (solo números)\n//==================================================\n\nif (typeof value === \"number\") {\n\n    if (variable.multiplier !== undefined) {\n        value *= variable.multiplier;\n    }\n\n    if (variable.decimals !== undefined) {\n        value = Number(value.toFixed(variable.decimals));\n    }\n\n}\n\n//==================================================\n\nmsg.payload = {\n    value: value\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 520,
        "y": 340,
