    {
        "id": "e239438f93e0c39b",
        "type": "function",
        "z": "6c26a882f341bc4c",
        "name": "MQTT Formatter (new)",
        "func": "const data = msg.payload;\n\nconst gateway = data.gateway;\nconst device = data.deviceId;\n\nconst messages = [];\n\nfor (const pointName in data.measurements) {\n    const measurement = data.measurements[pointName];\n\n    // Creamos un objeto de mensaje totalmente limpio desde cero\n    messages.push({\n        _msgid: msg._msgid, // Mantenemos el ID original de Node-RED por buenas prácticas\n        topic: `bms/${gateway}/${device}/${pointName}`,\n        // Enviamos SOLO el valor numérico crudo para que FUXA lo lea de forma nativa\n        payload: measurement.value \n    });\n}\n\n// Reemplazamos el payload original por nuestro array de mensajes limpios\nmsg.payload = messages;\n\n// Eliminamos de la raíz del mensaje toda la configuración pesada de Modbus\n// para que el nodo split no la herede ni la duplique.\ndelete msg.device;\ndelete msg.driver;\ndelete msg.variables;\ndelete msg.variable;\ndelete msg.gateway;\ndelete msg.modbusRequest;\ndelete msg.responseBuffer;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790.1999816894531,
        "y": 495.1999816894531,
        "wires": [
            []
        ]
    }
]